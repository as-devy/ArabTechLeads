# Supabase Auth / API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Never expose the service role key to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Prisma / Postgres (Supabase)
# Transaction pooler (6543) for the app runtime
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct or session mode (5432) for Prisma migrate
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (enable in Supabase Dashboard → Authentication → Providers → Google)
# Also add authorized redirect URI in Google Cloud Console:
# https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# And site callback:
# http://localhost:3000/auth/callback
