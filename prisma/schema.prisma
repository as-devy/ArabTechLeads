generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostType {
  TEXT
  CODE
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  COMMUNITY_ACTIVITY
  COMMUNITY_INVITE
  PROJECT_INVITATION
  PROJECT_JOIN_REQUEST
  JOIN_REQUEST_ACCEPTED
  JOIN_REQUEST_REJECTED
  PROJECT_MEMBER_JOINED
  TASK_ASSIGNED
  PROJECT_DISCUSSION
  JOB_APPLICATION
  MENTORSHIP_REQUEST
  EVENT_REGISTRATION
  ENDORSEMENT
  RECOMMENDATION
  SKILL_VERIFIED
  HACKATHON_RESULT
  MODERATION
  VOICE_INVITE
  VOICE_LIVE
  VOICE_SPEAK
  VOICE_REMINDER
}

enum ProjectType {
  OPEN_SOURCE
  STARTUP
  PORTFOLIO
  LEARNING
  RESEARCH
  HACKATHON
  COMMUNITY
  OTHER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum CollaborationStatus {
  LOOKING
  COMPLETE
  NOT_LOOKING
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}

enum BudgetType {
  FIXED
  HOURLY
}

enum OpportunityStatus {
  OPEN
  CLOSED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Role {
  id        String    @id
  nameAr    String    @map("name_ar")
  nameEn    String    @map("name_en")
  createdAt DateTime  @default(now()) @map("created_at")
  profiles  Profile[]
  members   ProfileRole[]

  @@map("roles")
}

model Country {
  code      String    @id @db.Char(2)
  nameAr    String    @map("name_ar")
  nameEn    String    @map("name_en")
  createdAt DateTime  @default(now()) @map("created_at")
  profiles  Profile[]

  @@map("countries")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  image        String?
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  profile      Profile?

  @@map("users")
}

model Profile {
  id                   String    @id @db.Uuid
  email                String    @unique
  username             String?   @unique
  fullName             String?   @map("full_name")
  bio                  String?
  avatarUrl            String?   @map("avatar_url")
  coverUrl             String?   @map("cover_url")
  roleId               String?   @map("role_id")
  countryCode          String?   @map("country_code") @db.Char(2)
  githubUrl            String?   @map("github_url")
  linkedinUrl          String?   @map("linkedin_url")
  portfolioUrl         String?   @map("portfolio_url")
  resumeUrl            String?   @map("resume_url")
  headline             String?
  openToWork           Boolean   @default(false) @map("open_to_work")
  openToFreelance      Boolean   @default(false) @map("open_to_freelance")
  openToMentorship     Boolean   @default(false) @map("open_to_mentorship")
  employmentPreference String?   @map("employment_preference")
  workModePreference   String?   @map("work_mode_preference")
  preferredLocations   String[]  @default([]) @map("preferred_locations")
  locale               String    @default("ar")
  theme                String    @default("dark")
  onboardingCompleted  Boolean   @default(false) @map("onboarding_completed")
  isAdmin              Boolean   @default(false) @map("is_admin")
  suspendedAt          DateTime? @map("suspended_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user                 User      @relation(fields: [id], references: [id], onDelete: Cascade)
  role                 Role?     @relation(fields: [roleId], references: [id])
  country              Country?  @relation(fields: [countryCode], references: [code])
  roles                ProfileRole[]
  skills               ProfileSkill[]
  interests            ProfileInterest[]
  posts                Post[]
  comments             Comment[]
  likes                PostLike[]
  savedPosts           SavedPost[]
  followers            Follow[]  @relation("Following")
  following            Follow[]  @relation("Follower")
  sentConnections      Connection[] @relation("ConnectionRequester")
  receivedConnections  Connection[] @relation("ConnectionReceiver")
  communityMemberships CommunityMember[]
  communitiesCreated   Community[] @relation("CommunityCreator")
  communityInvitesSent CommunityInvitation[] @relation("CommunityInviteSender")
  communityInvitesRecv CommunityInvitation[] @relation("CommunityInviteRecipient")
  voiceRoomsCreated    VoiceRoom[]           @relation("VoiceRoomCreator")
  voiceRoomMembers     VoiceRoomMember[]
  voiceInvitesSent     VoiceRoomInvite[]     @relation("VoiceInviteSender")
  voiceInvitesRecv     VoiceRoomInvite[]     @relation("VoiceInviteRecipient")
  voiceReminders       VoiceRoomReminder[]
  notifications        Notification[] @relation("NotificationRecipient")
  actorNotifications   Notification[] @relation("NotificationActor")
  conversationMembers  ConversationMember[]
  sentMessages         Message[]
  ownedProjects        Project[]              @relation("ProjectOwner")
  projectMemberships   ProjectMember[]
  projectInvitesSent   ProjectInvitation[]    @relation("ProjectInviteSender")
  projectInvitesRecv   ProjectInvitation[]    @relation("ProjectInviteRecipient")
  projectJoinRequests  ProjectJoinRequest[]
  createdTasks         ProjectTask[]          @relation("TaskCreator")
  assignedTasks        ProjectTask[]          @relation("TaskAssignee")
  taskComments         ProjectTaskComment[]
  projectDiscussions   ProjectDiscussion[]
  discussionComments   ProjectDiscussionComment[]
  projectActivities    ProjectActivity[]
  githubAccount        GithubAccount?
  projectShowcases     ProjectShowcase[]
  certifications       Certification[]
  spokenLanguages      SpokenLanguage[]
  companiesCreated     Company[]              @relation("CompanyCreator")
  companyMemberships   CompanyMember[]
  jobsCreated          Job[]                  @relation("JobCreator")
  jobApplications      JobApplication[]
  freelanceCreated     FreelanceOpportunity[] @relation("FreelanceCreator")
  freelanceProposals   FreelanceProposal[]
  mentorProfile        MentorProfile?
  mentorshipAsMentor   MentorshipRequest[]    @relation("MentorshipMentor")
  mentorshipAsMentee   MentorshipRequest[]    @relation("MentorshipMentee")
  eventsOrganized      Event[]                @relation("EventOrganizer")
  eventRegistrations   EventRegistration[]
  hackathonsOrganized  Hackathon[]            @relation("HackathonOrganizer")
  hackathonTeams       HackathonTeamMember[]
  reportsFiled         Report[]
  reputationEvents     ReputationEvent[]
  endorsementsGiven    SkillEndorsement[]     @relation("EndorsementGiver")
  endorsementsReceived SkillEndorsement[]     @relation("EndorsementReceiver")
  recsWritten          ProfessionalRecommendation[] @relation("RecAuthor")
  recsReceived         ProfessionalRecommendation[] @relation("RecRecipient")
  assessmentAttempts   AssessmentAttempt[]
  skillVerifications   SkillVerification[]
  achievements         UserAchievement[]
  blocksMade           UserBlock[]            @relation("Blocker")
  blocksReceived       UserBlock[]            @relation("Blocked")
  mutes                UserMute[]
  analyticsEvents      AnalyticsEvent[]
  auditLogs            AdminAuditLog[]
  postInteractions     PostInteraction[]
  interestProfiles     UserInterestProfile[]

  @@index([username])
  @@index([roleId])
  @@index([countryCode])
  @@map("profiles")
}

model ProfileRole {
  profileId String   @map("profile_id") @db.Uuid
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([profileId, roleId])
  @@index([roleId])
  @@map("profile_roles")
}

model Skill {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique
  name      String
  createdAt DateTime       @default(now()) @map("created_at")
  profiles  ProfileSkill[]
  projects  ProjectTechnology[]
  jobs      JobSkill[]
  freelance FreelanceSkill[]
  endorsements SkillEndorsement[]
  verifications SkillVerification[]

  @@map("skills")
}

model ProfileSkill {
  profileId String   @map("profile_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@index([skillId])
  @@map("profile_skills")
}

model Interest {
  id        String            @id @default(uuid()) @db.Uuid
  slug      String            @unique
  nameAr    String            @map("name_ar")
  nameEn    String            @map("name_en")
  createdAt DateTime          @default(now()) @map("created_at")
  profiles  ProfileInterest[]

  @@map("interests")
}

model ProfileInterest {
  profileId  String   @map("profile_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@index([interestId])
  @@map("profile_interests")
}

model Post {
  id          String   @id @default(uuid()) @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  type        PostType @default(TEXT)
  content     String
  code        String?
  language    String?
  communityId String?  @map("community_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author      Profile         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community   Community?      @relation(fields: [communityId], references: [id], onDelete: SetNull)
  tags        PostTag[]
  comments    Comment[]
  likes       PostLike[]
  savedBy     SavedPost[]
  communityPosts CommunityPost[]
  notifications Notification[]
  interactions  PostInteraction[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([communityId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("posts")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  posts     PostTag[]
  interestProfiles UserInterestProfile[]

  @@map("tags")
}

model PostTag {
  postId    String   @map("post_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([postId, profileId])
  @@index([profileId])
  @@map("post_likes")
}

model SavedPost {
  postId    String   @map("post_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([postId, profileId])
  @@index([profileId, createdAt(sort: Desc)])
  @@map("saved_posts")
}

enum PostInteractionType {
  IMPRESSION
  VIEW
  LIKE
  COMMENT
  SAVE
  SHARE
  HIDE
  NOT_INTERESTED
}

enum InterestSource {
  EXPLICIT
  BEHAVIOR
  COMMUNITY
  PROJECT
  FOLLOW
  INTERACTION
}

model PostInteraction {
  id        String               @id @default(uuid()) @db.Uuid
  profileId String               @map("profile_id") @db.Uuid
  postId    String               @map("post_id") @db.Uuid
  type      PostInteractionType
  position  Int?
  feedVersion String             @default("v1") @map("feed_version")
  createdAt DateTime             @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([profileId, type, createdAt(sort: Desc)])
  @@index([postId, type])
  @@index([profileId, postId, type, createdAt(sort: Desc)])
  @@map("post_interactions")
}

model UserInterestProfile {
  profileId String         @map("profile_id") @db.Uuid
  tagId     String         @map("tag_id") @db.Uuid
  weight    Float
  source    InterestSource
  updatedAt DateTime       @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId, source])
  @@index([profileId, weight(sort: Desc)])
  @@index([tagId])
  @@map("user_interest_profiles")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  Profile @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following Profile @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Connection {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  receiverId  String           @map("receiver_id") @db.Uuid
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester Profile @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  Profile @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@map("connections")
}

model Community {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  nameAr      String   @map("name_ar")
  nameEn      String   @map("name_en")
  description String?
  icon        String?
  imageUrl    String?  @map("image_url")
  themeColor  String   @default("#0284c7") @map("theme_color")
  isOpen      Boolean  @default(true) @map("is_open")
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   Profile?               @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     CommunityMember[]
  posts       Post[]
  communityPosts CommunityPost[]
  events      Event[]
  invitations CommunityInvitation[]
  voiceRooms  VoiceRoom[]

  @@index([createdById])
  @@map("communities")
}

model CommunityMember {
  communityId String   @map("community_id") @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  role        String   @default("member")
  joinedAt    DateTime @default(now()) @map("joined_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([communityId, profileId])
  @@index([profileId])
  @@map("community_members")
}

model CommunityPost {
  communityId String   @map("community_id") @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([communityId, postId])
  @@index([postId])
  @@map("community_posts")
}

model CommunityInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  communityId String        @map("community_id") @db.Uuid
  inviterId   String        @map("inviter_id") @db.Uuid
  inviteeId   String        @map("invitee_id") @db.Uuid
  message     String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  inviter   Profile   @relation("CommunityInviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   Profile   @relation("CommunityInviteRecipient", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([communityId, inviteeId])
  @@index([inviteeId, status])
  @@map("community_invitations")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String?          @map("actor_id") @db.Uuid
  type        NotificationType
  postId      String?          @map("post_id") @db.Uuid
  message     String?
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient Profile @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     Profile? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  profileId      String    @map("profile_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([conversationId, profileId])
  @@index([profileId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Project {
  id                   String               @id @default(uuid()) @db.Uuid
  ownerId              String               @map("owner_id") @db.Uuid
  name                 String
  slug                 String               @unique
  shortDescription     String               @map("short_description")
  description          String
  projectType          ProjectType          @default(OPEN_SOURCE) @map("project_type")
  status               ProjectStatus        @default(PLANNING)
  visibility           ProjectVisibility    @default(PUBLIC)
  collaborationStatus  CollaborationStatus  @default(LOOKING) @map("collaboration_status")
  githubUrl            String?              @map("github_url")
  websiteUrl           String?              @map("website_url")
  demoUrl              String?              @map("demo_url")
  figmaUrl             String?              @map("figma_url")
  githubOwner          String?              @map("github_owner")
  githubRepo           String?              @map("github_repo")
  showcase             Boolean              @default(true)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  owner           Profile                   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         ProjectMember[]
  roles           ProjectRole[]
  technologies    ProjectTechnology[]
  invitations     ProjectInvitation[]
  joinRequests    ProjectJoinRequest[]
  tasks           ProjectTask[]
  discussions     ProjectDiscussion[]
  activities      ProjectActivity[]
  showcases       ProjectShowcase[]
  notifications   Notification[]
  milestones      ProjectMilestone[]
  issues          ProjectIssue[]
  releases        ProjectRelease[]
  docs            ProjectDoc[]
  submissions     HackathonSubmission[]
  voiceRooms      VoiceRoom[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, collaborationStatus])
  @@index([projectType])
  @@map("projects")
}

model ProjectRole {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  name             String
  description      String?
  requiredSkills   String[] @map("required_skills")
  positions        Int      @default(1)
  filledPositions  Int      @default(0) @map("filled_positions")
  createdAt        DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_roles")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  roleName  String   @default("member") @map("role_name")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@index([profileId])
  @@map("project_members")
}

model ProjectTechnology {
  projectId String @map("project_id") @db.Uuid
  skillId   String @map("skill_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@map("project_technologies")
}

model ProjectInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  senderId    String           @map("sender_id") @db.Uuid
