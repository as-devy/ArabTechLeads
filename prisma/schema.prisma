  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String
  target    String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  admin Profile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("admin_audit_logs")
}

model ProjectMilestone {
  id          String          @id @default(uuid()) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  title       String
  description String?
  status      MilestoneStatus @default(PLANNED)
  targetDate  DateTime?       @map("target_date")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  ProjectIssue[]

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectIssue {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  milestoneId String?       @map("milestone_id") @db.Uuid
  creatorId   String        @map("creator_id") @db.Uuid
  assigneeId  String?       @map("assignee_id") @db.Uuid
  title       String
  description String
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  labels      String[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone?      @relation(fields: [milestoneId], references: [id])
  comments  ProjectIssueComment[]

  @@index([projectId, status])
  @@map("project_issues")
}

model ProjectIssueComment {
  id        String   @id @default(uuid()) @db.Uuid
  issueId   String   @map("issue_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  issue ProjectIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("project_issue_comments")
}

model ProjectRelease {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  version     String
  title       String
  description String
  githubUrl   String?  @map("github_url")
  releasedAt  DateTime @default(now()) @map("released_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_releases")
}

model ProjectDoc {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  section   String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, section])
  @@map("project_docs")
}

model HackathonSubmission {
  id              String           @id @default(uuid()) @db.Uuid
  hackathonId     String           @map("hackathon_id") @db.Uuid
  projectId       String           @map("project_id") @db.Uuid
  title           String
  description     String
  demoUrl         String?          @map("demo_url")
  repoUrl         String?          @map("repo_url")
  presentationUrl String?          @map("presentation_url")
  status          SubmissionStatus @default(DRAFT)
  place           Int?
  award           String?
  createdAt       DateTime         @default(now()) @map("created_at")

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, projectId])
  @@index([hackathonId, status])
  @@map("hackathon_submissions")
}

enum VoiceRoomType {
  COMMUNITY
  PROJECT
  EVENT
  PUBLIC
  PRIVATE
}

enum VoiceRoomStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum VoiceVisibility {
  PUBLIC
  COMMUNITY
  MEMBERS
  PRIVATE
}

enum VoiceRole {
  OWNER
  MODERATOR
  SPEAKER
  LISTENER
}

enum VoiceMemberStatus {
  ACTIVE
  LEFT
  REMOVED
  BANNED
}

model VoiceRoom {
  id              String           @id @default(uuid()) @db.Uuid
  createdById     String           @map("created_by") @db.Uuid
  communityId     String?          @map("community_id") @db.Uuid
  projectId       String?          @map("project_id") @db.Uuid
  eventId         String?          @map("event_id") @db.Uuid
  name            String
  description     String?
  type            VoiceRoomType    @default(PUBLIC)
  visibility      VoiceVisibility  @default(PUBLIC)
  status          VoiceRoomStatus  @default(LIVE)
  locked          Boolean          @default(false)
  maxParticipants Int              @default(25) @map("max_participants")
  scheduledAt     DateTime?        @map("scheduled_at")
  startedAt       DateTime?        @map("started_at")
  endedAt         DateTime?        @map("ended_at")
  lastActivityAt  DateTime         @default(now()) @map("last_activity_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  createdBy Profile           @relation("VoiceRoomCreator", fields: [createdById], references: [id], onDelete: Cascade)
  community Community?        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event     Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members   VoiceRoomMember[]
  invites   VoiceRoomInvite[]
  events    VoiceRoomEvent[]
  reminders VoiceRoomReminder[]

  @@index([status, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([communityId, status])
  @@index([projectId, status])
  @@index([eventId, status])
  @@index([createdById])
  @@map("voice_rooms")
}

model VoiceRoomMember {
  id         String            @id @default(uuid()) @db.Uuid
  roomId     String            @map("room_id") @db.Uuid
  profileId  String            @map("profile_id") @db.Uuid
  role       VoiceRole         @default(LISTENER)
  status     VoiceMemberStatus @default(ACTIVE)
  handRaised Boolean           @default(false) @map("hand_raised")
  forceMuted Boolean           @default(false) @map("force_muted")
  joinedAt   DateTime          @default(now()) @map("joined_at")
  leftAt     DateTime?         @map("left_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  room    VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([roomId, profileId])
  @@index([profileId, status])
  @@index([roomId, status])
  @@map("voice_room_members")
}

model VoiceRoomInvite {
  id          String        @id @default(uuid()) @db.Uuid
  roomId      String        @map("room_id") @db.Uuid
  inviterId   String        @map("inviter_id") @db.Uuid
  inviteeId   String        @map("invitee_id") @db.Uuid
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  respondedAt DateTime?     @map("responded_at")

  room    VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter Profile   @relation("VoiceInviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee Profile   @relation("VoiceInviteRecipient", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([roomId, inviteeId])
  @@index([inviteeId, status])
  @@map("voice_room_invites")
}

model VoiceRoomReminder {
  id         String    @id @default(uuid()) @db.Uuid
  roomId     String    @map("room_id") @db.Uuid
  profileId  String    @map("profile_id") @db.Uuid
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  room    VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([roomId, profileId])
  @@index([profileId])
  @@map("voice_room_reminders")
}

model VoiceRoomEvent {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  payload   String?
  createdAt DateTime @default(now()) @map("created_at")

  room VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("voice_room_events")
}

